---
import { Image } from 'astro:assets';
import putnamMark from '../assets/putnam-light.png';
import Arrow from '../components/Arrow.astro';
import CmsImg from '../components/CmsImg.astro';
import ContactFooter from '../components/ContactFooter.astro';
import Lines from '../components/Lines.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { t, type Lang } from '../i18n';
import { getPutnam, getSettings } from '../lib/content';
import { CARD_WIDTHS, SAT, imageSrc, remoteImage } from '../lib/images';
import '../styles/global.css';
import '../styles/putnam.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = t(lang);
const [{ hero, process, principles, differences, cta }, contact] = await Promise.all([getPutnam(lang), getSettings(lang)]);
const pad = (n: number) => String(n).padStart(2, '0');
---
<html lang={lang}>
  <head>
    <SiteHead lang={lang} page="putnam" settings={contact} />
  </head>
  <body class="putnam-page">
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(min-width: 768px)').matches) document.documentElement.classList.add('motion-pending');</script>
    <a class="skip-link" href="#contenido">{ui.skipLink}</a>
    <SiteHeader lang={lang} page="putnam" contact={contact} />

    <main id="contenido" data-putnam>
      <section class="institutional-hero" id="inicio" aria-labelledby="putnam-title" data-header-theme="light">
        <div class="hero-copy" data-reveal-group>
          <p class="section-kicker">{hero.kicker}</p>
          <h1 id="putnam-title"><Lines text={hero.title} mode="hard" /></h1>
        </div>
        <div class="hero-details" data-reveal-group>
          <p class="hero-lead">{hero.lead}</p>
          <a class="hero-index" href="#enfoque">{ui.putnam.seeApproach} <Arrow /></a>
        </div>
        <figure class="hero-frame">
          {hero.video ? <video poster={remoteImage(imageSrc(hero.image), 1280, 70)} autoplay muted loop playsinline aria-hidden="true"><source src={hero.video} type="video/mp4" /></video> : <CmsImg image={hero.image} base={1280} widths={[640, 960, 1280]} quality={72} sat={SAT.hero} sizes="100vw" width="1800" height="1200" loading="eager" fetchpriority="high" />}
        </figure>
      </section>

      <section class="process" id="enfoque" aria-labelledby="process-title" data-process data-header-theme="light">
        <div class="process-stage" data-pin-stage>
          <header class="process-heading">
            <p class="section-kicker">{process.kicker}</p>
            <h2 id="process-title" class="visually-hidden">{process.kicker}</h2>
          </header>
          <div class="process-media-slot" data-media-slot></div>
          <div class="process-progress">
            <div class="process-counter"><span data-pin-current data-track-current>01</span><span aria-hidden="true">/</span><span>{pad(process.steps.length)}</span></div>
            <div class="process-rail" aria-hidden="true"><span data-pin-rail data-track-rail></span></div>
          </div>
        </div>
        <div class="process-track" data-h-track>
          {process.steps.map((step) => (
            <article class="process-panel" data-h-panel>
              <figure class="process-media">
                {step.image ? <CmsImg image={step.image} base={960} widths={CARD_WIDTHS} quality={75} sat={SAT.process} sizes="(max-width: 767px) 100vw, calc(100vw * 0.57)" width="1800" height="1200" loading="lazy" fetchpriority="low" /> : <div class="media-placeholder" role="img" aria-label={ui.putnam.imagePendingFor(step.title)}><span>{ui.putnam.imagePending}</span><b>{step.number}</b><small>{step.title}</small></div>}
                <div class="process-shade" aria-hidden="true"></div>
              </figure>
              <div class="process-copy">
                <span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="principles" aria-labelledby="principles-title" data-header-theme="dark">
        <p class="section-kicker">{principles.kicker}</p>
        <h2 id="principles-title" class="visually-hidden">{principles.title}</h2>
        <article class="principle principle--mission" data-reveal-group>
          <span>{principles.mission.label}</span>
          <h3>{principles.mission.title}</h3>
          <p>{principles.mission.text}</p>
        </article>
        <article class="principle principle--vision" data-reveal-group>
          <span>{principles.vision.label}</span>
          <h3>{principles.vision.title}</h3>
          <p>{principles.vision.text}</p>
        </article>
        <div class="values" data-reveal-group>
          <span>{principles.valuesLabel}</span>
          <h3>{principles.valuesTitle}</h3>
          <ol>{principles.values.map((value, index) => <li><b>{pad(index + 1)}</b>{value}</li>)}</ol>
        </div>
      </section>

      <section class="differences" aria-labelledby="differences-title" data-header-theme="dark">
        <header class="section-heading" data-reveal-group>
          <p class="section-kicker">{differences.kicker}</p>
          <h2 id="differences-title"><Lines text={differences.title} mode="hard" /></h2>
        </header>
        <div class="difference-list">
          {differences.items.map((item) => (
            <article class="difference" data-reveal-group><span>{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></article>
          ))}
        </div>
      </section>

      <section class="institutional-cta" aria-labelledby="cta-title" data-reveal-group data-header-theme="light">
        <p class="section-kicker">{cta.kicker}</p>
        <h2 id="cta-title"><Lines text={cta.title} /></h2>
        <div class="cta-actions">
          <a href={`mailto:${contact.email}`}>{ui.writeUs} <Arrow dir="up-right" /></a>
          <a href={contact.whatsapp} target="_blank" rel="noreferrer">{ui.whatsapp} <Arrow dir="up-right" /></a>
        </div>
        <Image class="cta-mark" src={putnamMark} widths={[400, 800]} sizes="(max-width: 767px) min(50vw, 14rem), min(42vw, 42rem)" format="webp" alt="" aria-hidden="true" />
      </section>
    </main>
    <ContactFooter lang={lang} contact={contact} />
    <script src="../scripts/putnam-motion.ts"></script>
  </body>
</html>
