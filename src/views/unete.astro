---
import { Image } from 'astro:assets';
import putnamMark from '../assets/putnam-light.png';
import Arrow from '../components/Arrow.astro';
import CmsImg from '../components/CmsImg.astro';
import ContactFooter from '../components/ContactFooter.astro';
import Lines from '../components/Lines.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { pages, t, type Lang } from '../i18n';
import { getSettings, getUnete } from '../lib/content';
import { HERO_WIDTHS, SAT } from '../lib/images';
import '../styles/global.css';
import '../styles/unete.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = t(lang);
const [{ hero, culture, profile, openings, process, spontaneous, apply, mail }, contact] = await Promise.all([getUnete(lang), getSettings(lang)]);
const pad = (index: number) => String(index + 1).padStart(2, '0');
const profileMailto = (subject: string) => `mailto:${contact.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(mail.body)}`;
const profileWhatsapp = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(mail.whatsapp)}`;
const sendProfile = profileMailto(ui.unete.profileSubject);
const contactHref = pages.contacto[lang];
---
<html lang={lang}>
  <head>
    <SiteHead lang={lang} page="unete" settings={contact} />
  </head>
  <body class="unete-page">
    <a class="skip-link" href="#contenido">{ui.skipLink}</a>
    <SiteHeader lang={lang} page="unete" contact={contact} />

    <main id="contenido" data-unete>
      <section class="un-hero" id="inicio" aria-labelledby="un-hero-title" data-header-theme="light">
        <div class="hero-copy">
          <p class="section-kicker fade-up"><span>{hero.kicker} · {contact.city}</span></p>
          <h1 id="un-hero-title"><Lines text={hero.title} /></h1>
        </div>
        <div class="hero-details fade-up">
          <div><p class="hero-lead">{hero.lead}</p><a class="hero-index" href="#cultura">{ui.unete.seeCulture} <span aria-hidden="true">↓</span></a></div>
          <div class="hero-meta">{hero.meta.map((line) => <span>{line}</span>)}</div>
        </div>
        <figure class="hero-frame">
          <CmsImg image={hero.image} base={1280} widths={HERO_WIDTHS} quality={72} sat={SAT.hero} sizes="100vw" width="2200" height="1467" loading="eager" fetchpriority="high" />
        </figure>
      </section>

      <section class="un-culture" id="cultura" aria-labelledby="un-culture-title" data-culture data-header-theme="light">
        <div class="pin-stage" data-pin-stage>
          <div><p class="section-kicker">{culture.kicker}</p><h2 id="un-culture-title"><Lines text={culture.title} /></h2><p class="pin-lead">{culture.text}</p></div>
          <div><div class="pin-counter"><b data-pin-current data-track-current>01</b><span aria-hidden="true">/</span><span>{pad(culture.traits.length - 1)}</span></div><div class="pin-rail" aria-hidden="true"><span data-pin-rail data-track-rail></span></div></div>
        </div>
        <div class="traits" data-traits>
          {culture.traits.map((trait, index) => (
            <article class:list={["trait", { "is-active": index === 0 }]} data-trait={index}><span>{pad(index)} — {ui.unete.trait}</span><h3>{trait.title}</h3><p>{trait.text}</p></article>
          ))}
        </div>
      </section>

      <section class="un-profile" id="perfil" aria-labelledby="un-profile-title" data-header-theme="dark">
        <header class="section-head grid-12">
          <div><p class="section-kicker">{profile.kicker}</p><h2 id="un-profile-title" class="h2-long"><Lines text={profile.title} /></h2></div>
          <p data-reveal-group>{profile.text}</p>
        </header>
        <div class="values" data-reveal-group>
          {profile.values.map((value, index) => <article class="value"><span>{pad(index)}</span><h3>{value.title}</h3><p>{value.text}</p></article>)}
        </div>
        <div class="kpis" data-reveal-group>
          {profile.kpis.map((kpi) => <div class="kpi"><b>{kpi.value}</b><span>{kpi.label}</span></div>)}
        </div>
      </section>

      <section class="un-openings" id="oportunidades" aria-labelledby="un-openings-title" data-header-theme="dark">
        <header class="section-head grid-12">
          <div><p class="section-kicker">{openings.kicker}</p><h2 id="un-openings-title" class="h2-xl"><Lines text={openings.title} /></h2></div>
          <p data-reveal-group>{openings.text}</p>
        </header>
        <div class="empty-panel grid-12" data-reveal-group>
          <div>
            <p class="section-kicker">{openings.emptyKicker}</p>
            <h3>{openings.emptyTitle}</h3>
            {openings.emptyText.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <div class="empty-actions">
            <a class="panel-button" href={sendProfile}>{openings.cta} <Arrow /></a>
            <div class="cta-actions"><a href={contactHref}>{ui.goToContact} <Arrow dir="up-right" /></a></div>
          </div>
        </div>
      </section>

      <section class="un-process" id="proceso" aria-labelledby="un-process-title" data-header-theme="dark">
        <header class="section-head grid-12">
          <div><p class="section-kicker">{process.kicker}</p><h2 id="un-process-title"><Lines text={process.title} /></h2></div>
          <p data-reveal-group>{process.text}</p>
        </header>
        <div class="steps" data-reveal-group>
          {process.steps.map((step, index) => <article class="step"><span>{pad(index)}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}
        </div>
      </section>

      <section class="un-spontaneous" id="postulacion" aria-labelledby="un-spontaneous-title" data-header-theme="dark">
        <header class="section-head grid-12">
          <div><p class="section-kicker">{spontaneous.kicker}</p><h2 id="un-spontaneous-title"><Lines text={spontaneous.title} /></h2></div>
          <p data-reveal-group>{spontaneous.text}</p>
        </header>
        <div class="index-list" data-reveal-group>
          {spontaneous.fields.map((field, index) => (
            <a class="index-row" href={profileMailto(ui.unete.spontaneousSubject(field))}><span>{pad(index)}</span><div><small>{ui.unete.sendProfile}</small><strong>{field}</strong></div><Arrow dir="up-right" as="i" /></a>
          ))}
        </div>
      </section>

      <section class="un-cta" aria-labelledby="un-cta-title" data-header-theme="light">
        <p class="section-kicker">{apply.kicker}</p>
        <h2 id="un-cta-title"><Lines text={apply.title} /></h2>
        <p data-reveal-group>{apply.text}</p>
        <div class="cta-actions" data-reveal-group><a href={sendProfile}>{ui.unete.sendProfile} <Arrow dir="up-right" /></a><a href={profileWhatsapp} target="_blank" rel="noreferrer">{ui.whatsapp} <Arrow dir="up-right" /></a><a href={contactHref}>{ui.goToContact} <Arrow dir="up-right" /></a></div>
        <Image class="cta-mark" src={putnamMark} widths={[400, 800]} sizes="(max-width: 767px) min(50vw, 14rem), min(42vw, 42rem)" format="webp" alt="" aria-hidden="true" />
      </section>
    </main>
    <ContactFooter lang={lang} contact={contact} />
    <script src="../scripts/unete-motion.ts"></script>
  </body>
</html>
