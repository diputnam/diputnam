---
import { Image } from 'astro:assets';
import putnamMark from '../assets/putnam-light.png';
import Arrow from '../components/Arrow.astro';
import CmsImg from '../components/CmsImg.astro';
import ContactFooter from '../components/ContactFooter.astro';
import Lines from '../components/Lines.astro';
import MapEmbed from '../components/MapEmbed.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { t, type Lang } from '../i18n';
import { getContacto, getSettings } from '../lib/content';
import { HERO_WIDTHS, SAT, imageSrc, remoteImage } from '../lib/images';
import '../styles/global.css';
import '../styles/contacto.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = t(lang);
const form = ui.contacto.form;
const [{ hero, channels, reasons, location, form: formCopy, cta }, contact] = await Promise.all([getContacto(lang), getSettings(lang)]);
const pad = (index: number) => String(index + 1).padStart(2, '0');
// On narrow phones the address is wider than its column; a break opportunity before `@`
// wraps it as user / @domain instead of mid-word.
const [emailUser, emailDomain] = contact.email.split('@');
---
<html lang={lang}>
  <head>
    <SiteHead lang={lang} page="contacto" settings={contact} />
  </head>
  <body class="contacto-page">
    <a class="skip-link" href="#contenido">{ui.skipLink}</a>
    <SiteHeader lang={lang} page="contacto" contact={contact} contacto />

    <main id="contenido" data-contacto>
      <section class="ct-hero" id="inicio" aria-labelledby="ct-hero-title" data-header-theme="light">
        <div class="hero-copy">
          <p class="section-kicker fade-up"><span>{hero.kicker} · {contact.city}</span></p>
          <h1 id="ct-hero-title"><Lines text={hero.title} /></h1>
        </div>
        <div class="hero-details fade-up">
          <div><p class="hero-lead">{hero.lead}</p><a class="hero-index" href="#canales">{ui.contacto.seeChannels} <span aria-hidden="true">↓</span></a></div>
          <div class="hero-meta"><span>{contact.hoursShort}</span><span>{ui.contacto.responseIn(contact.responseTime)}</span></div>
        </div>
        <figure class="hero-frame" data-parallax>
          {hero.video ? <video poster={remoteImage(imageSrc(hero.image), 1280, 70)} autoplay muted loop playsinline aria-hidden="true"><source src={hero.video} type="video/mp4" /></video> : <CmsImg image={hero.image} base={1280} widths={HERO_WIDTHS} quality={72} sat={SAT.hero} sizes="100vw" width="2200" height="1467" loading="eager" fetchpriority="high" />}
        </figure>
      </section>

      <section class="ct-channels" id="canales" aria-labelledby="ct-channels-title" data-header-theme="dark">
        <header class="ct-channels-head grid-12">
          <div><p class="section-kicker">{channels.kicker}</p><h2 id="ct-channels-title"><Lines text={channels.title} /></h2></div>
          <p data-reveal-group>{channels.text}</p>
        </header>
        <div class="index-list" data-reveal-group>
          <a class="index-row" href={contact.whatsapp} target="_blank" rel="noreferrer"><span>01</span><div><small>{ui.whatsapp}</small><strong>{contact.phone}</strong></div><Arrow dir="up-right" as="i" /></a>
          <a class="index-row" href={`mailto:${contact.email}`}><span>02</span><div><small>{ui.contacto.email}</small><strong>{emailUser}<wbr />@{emailDomain}</strong></div><Arrow dir="up-right" as="i" /></a>
          <div class="index-row"><span>03</span><div><small>{ui.contacto.office}</small><strong>{contact.address}</strong></div><i aria-hidden="true"></i></div>
          <div class="index-row"><span>04</span><div><small>{ui.contacto.hours}</small><strong>{contact.hours}</strong></div><i aria-hidden="true"></i></div>
        </div>
        <div class="kpis" data-reveal-group>
          {channels.kpis.map((kpi) => <div class="kpi"><b>{kpi.value ?? contact.responseTime}</b><span>{kpi.label}</span></div>)}
        </div>
      </section>

      <section class="ct-reasons" id="motivos" aria-labelledby="ct-reasons-title" data-reasons data-header-theme="light">
        <div class="pin-stage" data-pin-stage>
          <div><p class="section-kicker">{reasons.kicker}</p><h2 id="ct-reasons-title"><Lines text={reasons.title} /></h2></div>
          <div><div class="pin-counter"><b data-pin-current data-track-current>01</b><span aria-hidden="true">/</span><span>{pad(reasons.items.length - 1)}</span></div><div class="pin-rail" aria-hidden="true"><span data-pin-rail data-track-rail></span></div></div>
        </div>
        <div class="reasons" data-reasons-track>
          {reasons.items.map((reason, index) => (
            <article class:list={["reason", { "is-active": index === 0 }]} data-reason={index}><span>{pad(index)} — {reason.tag}</span><h3>{reason.title}</h3><p>{reason.text}</p>{reason.target === 'whatsapp' ? <a href={contact.whatsapp} target="_blank" rel="noreferrer">{reason.cta} <Arrow /></a> : <a href="#formulario">{reason.cta} <Arrow /></a>}</article>
          ))}
        </div>
      </section>

      <section class="ct-location grid-12" id="ubicacion" aria-labelledby="ct-location-title" data-header-theme="dark">
        <figure class="ct-map"><MapEmbed coordinates={contact.coordinates} title={ui.contacto.mapTitle} /></figure>
        <div class="ct-location-copy">
          <p class="section-kicker">{location.kicker}</p>
          <h2 id="ct-location-title"><Lines text={location.title} /></h2>
          <p data-reveal-group>{location.text}</p>
          <dl data-reveal-group><div><dt>{ui.contacto.address}</dt><dd>{contact.address} · {contact.city}</dd></div><div><dt>{ui.contacto.schedule}</dt><dd>{contact.hours}</dd></div></dl>
          <div class="cta-actions"><a href={contact.mapsUrl} target="_blank" rel="noreferrer">{ui.contacto.openMaps} <Arrow dir="up-right" /></a></div>
        </div>
      </section>

      <section class="ct-form" id="formulario" aria-labelledby="ct-form-title" data-header-theme="dark">
        <header class="ct-form-head grid-12">
          <div><p class="section-kicker">{formCopy.kicker}</p><h2 id="ct-form-title"><Lines text={formCopy.title} /></h2></div>
          <p data-reveal-group>{formCopy.text?.replace('{responseTime}', contact.responseTime)}</p>
        </header>
        <form action="#" aria-label={form.aria} data-contact-form data-submit={form.submit} data-sending={form.sending} data-retry={form.retry} data-success={form.success} data-error={form.error} data-required={form.required} data-invalid-email={form.invalidEmail}>
          <div data-form-fields data-reveal-group>
            <div class="f-row"><span>01</span><label for="ct-nombre">{form.name}</label><input id="ct-nombre" name="nombre" type="text" autocomplete="name" maxlength="120" required placeholder={form.namePlaceholder} /></div>
            <div class="f-row"><span>02</span><label for="ct-empresa">{form.company}</label><input id="ct-empresa" name="empresa" type="text" autocomplete="organization" maxlength="160" placeholder={form.companyPlaceholder} /></div>
            <div class="f-row"><span>03</span><label for="ct-email">{form.email}</label><input id="ct-email" name="email" type="email" autocomplete="email" maxlength="254" required placeholder={form.emailPlaceholder} /></div>
            <div class="f-row"><span>04</span><label for="ct-telefono">{form.phone}</label><input id="ct-telefono" name="telefono" type="tel" autocomplete="tel" maxlength="50" placeholder={form.phonePlaceholder} /></div>
            <div class="f-row"><span>05</span><label for="ct-motivo">{form.reason}</label><select id="ct-motivo" name="motivo" required data-custom-select>{form.reasons.map((reason) => <option>{reason}</option>)}</select></div>
            <div class="f-row f-row--text"><span>06</span><label for="ct-mensaje">{form.message}</label><textarea id="ct-mensaje" name="mensaje" maxlength="4000" required placeholder={form.messagePlaceholder}></textarea></div>
          </div>
          <div class="f-honeypot" aria-hidden="true"><label for="ct-website">Website</label><input id="ct-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <div class="f-submit"><p>{form.consent}</p><button type="submit"><b data-submit-label>{form.submit}</b> <Arrow /></button><p class="f-status" role="status" aria-live="polite" aria-atomic="true" data-form-status></p></div>
          <div class="f-success" role="status" aria-live="polite" aria-atomic="true" data-form-success hidden><span aria-hidden="true"><svg viewBox="0 0 32 32"><path d="m7 16 6 6L25 10" /></svg></span><h3>{form.successTitle}</h3><p>{form.success}</p></div>
        </form>
      </section>

      <section class="ct-cta" aria-labelledby="ct-cta-title" data-header-theme="light">
        <p class="section-kicker">{cta.kicker}</p>
        <h2 id="ct-cta-title"><Lines text={cta.title} /></h2>
        <p data-reveal-group>{cta.text}</p>
        <div class="cta-actions" data-reveal-group><a href={contact.whatsapp} target="_blank" rel="noreferrer">{ui.contacto.openWhatsapp} <Arrow dir="up-right" /></a></div>
        <Image class="cta-mark" src={putnamMark} widths={[400, 800]} sizes="(max-width: 767px) min(50vw, 14rem), min(42vw, 42rem)" format="webp" alt="" aria-hidden="true" />
      </section>
    </main>
    <ContactFooter lang={lang} contact={contact} />
    <script src="../scripts/contacto-motion.ts"></script>
    <script src="../scripts/contacto-form.ts"></script>
  </body>
</html>
