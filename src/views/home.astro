---
import { pages, t, type Lang } from '../i18n';
import { getHome, getSettings } from '../lib/content';
import { HERO_WIDTHS, SAT, imageSrc, remoteImage } from '../lib/images';
import CmsImg from '../components/CmsImg.astro';
import ContactFooter from '../components/ContactFooter.astro';
import Lines from '../components/Lines.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = t(lang);
const [{ scenes }, contact] = await Promise.all([getHome(lang), getSettings(lang)]);

// Mobile scene sweep is a CSS scroll-driven animation: each scene marker names a view
// timeline and panel n plays its entrance on --scene-n and its exit on --scene-(n+1).
// The first panel only exits and the last only enters (an animation without a timeline
// would still apply its end state), so name and timeline lists are assigned per panel.
const scene = (index: number) => `--scene-${index}`;
const timelineScope = scenes.map((_, index) => scene(index)).join(', ');
const sweep = (index: number, enter: string, exit: string) => {
  const parts = [index > 0 && [enter, scene(index)], index + 1 < scenes.length && [exit, scene(index + 1)]].filter(Boolean) as [string, string][];
  return `animation-name: ${parts.map(([name]) => name).join(', ')}; animation-timeline: ${parts.map(([, timeline]) => timeline).join(', ')}`;
};
const sceneHref = (id: string) => (id === 'putnam' || id === 'eredita' || id === 'contacto' ? pages[id][lang] : `#${id}`);
---

<html lang={lang}>
  <head>
    <SiteHead lang={lang} page="home" settings={contact} />
  </head>
  <body class="home-page">
    <SiteHeader lang={lang} page="home" contact={contact} home />

    <main class="home" data-home>
      <div class="home-experience" data-experience style={`timeline-scope: ${timelineScope}`}>
        <div class="home-stage" data-stage>
          {scenes.map((panel, index) => (
            <section class:list={["panel", { "panel--intro": index === 0, "is-active": index === 0, "is-visible": index === 0 }]} id={panel.id} data-panel data-index={index} style={sweep(index, 'scene-enter', 'scene-exit')}>
              {panel.video ? <video class="panel-media" poster={remoteImage(imageSrc(panel.image), 1280, 70)} autoplay muted loop playsinline aria-hidden="true"><source src={panel.video} type="video/mp4" /></video> : <CmsImg class="panel-media" image={panel.image} base={1280} widths={HERO_WIDTHS} quality={75} sat={SAT.panel} sizes="100vw" width="2200" height="1467" loading={index < 2 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} decoding="sync" />}
              <div class="panel-shade"></div>
              <div class="panel-content" style={sweep(index, 'title-in', 'title-out')}>
                {index === 0 ? <h1><a href={`#${panel.id}`}><Lines text={panel.title} mode="hard" /></a></h1> : <h2><a href={sceneHref(panel.id)}><Lines text={panel.title} mode="hard" /></a></h2>}
              </div>
            </section>
          ))}
        </div>
        <div class="scene-markers" data-scene-markers aria-hidden="true">
          {scenes.map((panel, index) => (
            <section class="scene-marker" data-scene-marker={panel.id} data-index={index} style={`view-timeline-name: ${scene(index)}`}></section>
          ))}
        </div>
      </div>
      <div data-scroll-end aria-hidden="true"></div>
    </main>

    <ContactFooter lang={lang} contact={contact} fixed />
    <button class="scroll-cue" type="button" aria-label={ui.scrollCue} data-scroll-cue>
      <span aria-hidden="true"></span>
    </button>

    <script src="../scripts/motion.ts"></script>
  </body>
</html>
