# Site build (astro build) reads these; set them in the host too (Cloudflare/Vercel).
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Offline alternative (takes precedence): build from studio/.local/dataset.json,
# generated with `node studio/scripts/seed-local.ts`.
# SANITY_LOCAL_DATASET=studio/.local/dataset.json
# Host the social cover (og:image) is served from. Vercel fills it in from
# VERCEL_PROJECT_PRODUCTION_URL; set it only to override (e.g. a preview host).
# PUBLIC_ASSET_ORIGIN=https://diputnam-ten.vercel.app

# Contact form (server-only; never prefix these with PUBLIC_).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
