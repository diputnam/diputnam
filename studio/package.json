{
  "name": "diputnam-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Sanity Studio for the Putnam site. Separate install: the site build never pulls these dependencies.",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "migrate:proyectos": "sanity exec scripts/migrate-proyectos.ts --with-user-token"
  },
  "dependencies": {
    "@sanity/document-internationalization": "^6.2.35",
    "@sanity/language-filter": "^5.0.18",
    "@sanity/vision": "^6.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.15.0",
    "sanity-plugin-internationalized-array": "^5.3.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
